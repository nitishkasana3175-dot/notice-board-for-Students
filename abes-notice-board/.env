# Copy to .env for local development:  Copy-Item .env.example .env
# NEVER commit the real .env file.

# Required in production: a long random string (32+ chars).
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-characters

# Passwords for the seeded demo accounts (used only when the account is first created)
ADMIN_PASSWORD=Admin@12345
FACULTY_PASSWORD=Faculty@12345
STUDENT_PASSWORD=Student@12345

# Leave empty locally (uses JSON files). Required on Render (PostgreSQL).
DATABASE_URL=
# NODE_ENV=production   (set on Render)
